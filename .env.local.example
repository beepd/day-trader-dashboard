# Copy this file to .env.local and fill it in. .env.local is git-ignored. Never commit real values.

# The Supabase project the trading app writes to
SUPABASE_URL=https://your-project.supabase.co

# The PUBLISHABLE key (safe to publish). NEVER the secret / service-role key: the dashboard refuses it.
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional: the address of the blog (the BLOG tab, the About text and the footer link to it).
# Leave empty to use the default, https://blog.niftyexperiment.com
BLOG_URL=

# Optional: how long (seconds) an answer from Supabase may be reused. Default 300 (5 minutes). 0 = no cache.
DASHBOARD_CACHE_SECONDS=300

# Optional: Google Analytics 4 measurement ID (looks like G-ABC123XYZ9). Leave empty to switch analytics off.
# Set it in Vercel (Settings > Environment Variables) and redeploy; it is read when the site is built.
NEXT_PUBLIC_GA_ID=

# Optional: show made-up sample data instead of reading Supabase (to preview the layout)
DASHBOARD_DEMO=
